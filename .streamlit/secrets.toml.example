# Copy these values into Streamlit Community Cloud > App settings > Secrets.
# Never commit a real secrets.toml file.

DEEPSEEK_API_KEY = "replace-with-your-key"
DATABASE_URL = "postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require"
FAMILY_AUTH_ENABLED = true
ALLOWED_USER_EMAILS = "owner@gmail.com,family-member@gmail.com"
ADMIN_USER_EMAILS = "owner@gmail.com"
DAILY_API_LIMIT = 20
MONTHLY_API_LIMIT = 300

[auth]
redirect_uri = "https://china-legal-ai-copilot-gatttcxhnxrdakyccb85mm.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-google-oauth-client-id"
client_secret = "replace-with-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
