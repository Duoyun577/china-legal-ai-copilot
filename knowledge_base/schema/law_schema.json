{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://china-legal-ai-copilot.local/schema/law.schema.json",
  "title": "中国法律条文知识库条目",
  "description": "适用于 knowledge_base/laws 的条文数组；不包含任何具体法律正文。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["law_id", "law_name", "article", "chapter", "topic", "legal_text", "keywords", "applicable_contracts", "risk_rules", "lawyer_application", "source"],
    "properties": {
      "law_id": {"type": "string", "minLength": 1},
      "law_name": {"type": "string", "minLength": 1},
      "article": {"type": "string", "minLength": 1},
      "chapter": {"type": "string"},
      "topic": {"type": "string", "minLength": 1},
      "legal_text": {"type": "string", "minLength": 1},
      "keywords": {"type": "array", "items": {"type": "string"}},
      "applicable_contracts": {"type": "array", "items": {"type": "string"}},
      "risk_rules": {"type": "array", "items": {"type": "string", "pattern": "^CR-[0-9]{3}$"}},
      "lawyer_application": {"type": "string", "minLength": 1},
      "source": {"type": "string", "format": "uri"}
    }
  }
}
